<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>AgentCenter third-party licences</title>
<style>
body { font: 14px/1.5 system-ui, sans-serif; max-width: 60em; margin: 2em auto; padding: 0 1em; }
pre { white-space: pre-wrap; background: #f4f4f4; padding: 1em; overflow-x: auto; }
li { margin: 0.2em 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>AgentCenter is AGPL-3.0-or-later (see LICENSE and NOTICE). It is built with the crates below, each under the licence shown.</p>
<h2>Summary</h2>
<ul>
{{#each overview}}
<li>{{name}} ({{count}})</li>
{{/each}}
</ul>
<h2>Licences</h2>
{{#each licenses}}
<section id="{{id}}-{{@index}}">
<h3>{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
